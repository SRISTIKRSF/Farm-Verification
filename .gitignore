# Dev patch scripts (used to edit index.html, not part of the app)
_*.py
_*.js

# Claude Code session files
.claude/

# Local version backups (keep on disk, don't push to GitHub)
index-V*.html

# Firebase data snapshots — real farmer PII, this repo is public. Never push.
_backups/

# Security plan — documents live, unfixed vulnerabilities. This repo is
# public, so publishing it would hand an attacker the roadmap. Never push.
SECURITY-PLAN.md

# Operational docs (Runbook / Data Note / Decision Log). Same reason as
# SECURITY-PLAN.md — the Decision Log describes unfixed holes and the Data
# Note says exactly where the farmer PII sits. Publishing the Runbook alone
# would be a deliberate decision, not a default.
docs/0*-*.md
docs/0*-*.docx

# Firebase CLI deploy cache (hosting-redirect)
hosting-redirect/.firebase/

# FC/mobilizer training guide. Harmless in itself (no farmer data, mockups not
# screenshots), but nothing in docs/ is published to a PUBLIC repo by default -
# putting it on GitHub should be a deliberate decision, not a stray git add.
docs/Khedut-Chakasani-Guide-GU.html
docs/Khedut-Chakasani-Guide.pdf
