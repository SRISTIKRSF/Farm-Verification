{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "prakrutik_kheti": {
      "haatFarmers": { ".indexOn": ["district", "fcId"] },
      "convFarmers": { ".indexOn": ["district", "fcId"] },

      "phoneIndex": {
        "$phone": {
          ".validate": "!data.exists() && newData.isString() && newData.val().length <= 64"
        }
      }
    }
  }
}
